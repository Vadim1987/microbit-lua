--- luaconf.h
+++ luaconf.h
@@ -511,8 +511,12 @@
 
 /*
 @@ LUAL_BUFFERSIZE is the buffer size used by the lauxlib buffer system.
+@* A buffer lives on the C stack of the function that builds a string with
+@* it, such as string.format, gsub, rep, upper and lower, and table.concat.
+@* Its frame is the deepest a Lua call makes below the C stack check
+@* (luai_cstack): a smaller buffer keeps it within the check's margin.
 */
-#define LUAL_BUFFERSIZE		BUFSIZ
+#define LUAL_BUFFERSIZE		256
 
 /* }================================================================== */
 
